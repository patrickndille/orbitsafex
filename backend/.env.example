# ──────────────────────────────────────────────────────────────────────────────
# OrbitSafe AI – environment configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# OpenAI-compatible API key (required for /api/triage)
OPENAI_API_KEY=your-api-key-here

# Base URL – change to use IBM watsonx, Gemini, or another OpenAI-compatible endpoint
# Default OpenAI:  https://api.openai.com/v1
# IBM watsonx:     https://us-south.ml.cloud.ibm.com/ml/v1/...
OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier (e.g. gpt-4o-mini, ibm/granite-3-8b-instruct, gemini-1.5-flash)
LLM_MODEL=gpt-4o-mini
