# ──────────────────────────────────────────────────────────────────────────────
# OrbitSafe AI – environment configuration
# Copy this file to .env and fill in your values.
# Do NOT commit .env or credentials to version control.
# ──────────────────────────────────────────────────────────────────────────────

# OpenAI-compatible API key (required for /api/triage)
OPENAI_API_KEY=your-api-key-here

# Base URL – change to use IBM watsonx, Gemini, or another OpenAI-compatible endpoint
# Default OpenAI:  https://api.openai.com/v1
# IBM watsonx:     https://us-south.ml.cloud.ibm.com/ml/v1/...
OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier (e.g. gpt-4o-mini, ibm/granite-3-8b-instruct, gemini-1.5-flash)
LLM_MODEL=gpt-4o-mini

# Space-Track.org credentials (required for live GP data)
# Register free at https://www.space-track.org/auth/createAccount
# Without credentials, the system falls back to the local GP snapshot (data/gp_fallback.json)
SPACE_TRACK_USERNAME=
SPACE_TRACK_PASSWORD=

# GP data source priority
#   auto         – Space-Track (if credentials are set) → local fallback (default)
#   space-track  – Space-Track only (errors if credentials missing)
#   local        – Local fallback file only (offline mode)
#
# Note: CelesTrak is no longer supported. The local fallback (data/gp_fallback.json)
# is auto-maintained from successful Space-Track fetches.
GP_SOURCE=auto
